rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 40 &&
             data.totalScore is int &&
             data.totalScore >= 0 &&
             data.totalScore <= 1000000 &&
             data.storiesCompleted is int &&
             data.storiesCompleted >= 0 &&
             data.storiesCompleted <= 1000 &&
             (!('lastStoryTitle' in data) || data.lastStoryTitle == null || (data.lastStoryTitle is string && data.lastStoryTitle.size() <= 160)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidStoryScore(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.storyId is string &&
             isValidId(data.storyId) &&
             data.postId is string &&
             data.postId.size() >= 1 &&
             data.postId.size() <= 200 &&
             data.postTitle is string &&
             data.postTitle.size() >= 1 &&
             data.postTitle.size() <= 200 &&
             data.score is int &&
             data.score >= 0 &&
             data.score <= 1000 &&
             data.maxScore is int &&
             data.maxScore >= 1 &&
             data.maxScore <= 1000 &&
             data.score <= data.maxScore &&
             data.correctAnswers is int &&
             data.correctAnswers >= 0 &&
             data.correctAnswers <= 20 &&
             data.totalQuestions is int &&
             data.totalQuestions >= 1 &&
             data.totalQuestions <= 20 &&
             data.correctAnswers <= data.totalQuestions &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Shared leaderboard collection (zero PII; owner-only writes, signed-in reads)
    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'displayName', 'totalScore', 'storiesCompleted', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'totalScore', 'storiesCompleted', 'lastStoryTitle', 'createdAt', 'updatedAt']) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidLeaderboardEntry(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'totalScore', 'storiesCompleted', 'lastStoryTitle', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // Strictly isolated per-user story score breakdown
    match /users/{userId}/story_scores/{storyId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(storyId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(storyId) &&
                       request.auth.uid == userId &&
                       incoming().storyId == storyId &&
                       incoming().keys().hasAll(['userId', 'storyId', 'postId', 'postTitle', 'score', 'maxScore', 'correctAnswers', 'totalQuestions', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'storyId', 'postId', 'postTitle', 'score', 'maxScore', 'correctAnswers', 'totalQuestions', 'createdAt', 'updatedAt']) &&
                       isValidStoryScore(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(storyId) &&
                       request.auth.uid == userId &&
                       incoming().storyId == existing().storyId &&
                       incoming().postId == existing().postId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidStoryScore(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['postTitle', 'score', 'maxScore', 'correctAnswers', 'totalQuestions', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && isValidId(storyId) && request.auth.uid == userId;
    }
  }
}
